    "check:privacy": "node scripts/check-privacy.mjs",
    "verify": "npm run test && npm run build && npm run check:privacy"
  },
  "dependencies": {
    "csv-parse": "7.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
